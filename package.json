{
  "name": "pi-auto-compact",
  "version": "0.2.0",
  "description": "pi extension: auto-compact the context at a percentage of the model's window with a checkpoint that keeps a verbatim record of the conversation, without ever interrupting the running agent.",
  "keywords": ["pi-package", "pi", "pi-extension", "compaction", "context", "tokens"],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G4bar/pi-auto-compact.git"
  },
  "files": ["src", "README.md", "LICENSE"],
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
